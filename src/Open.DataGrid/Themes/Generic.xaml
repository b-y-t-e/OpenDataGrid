<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Open.DataGrid.Controls">

    <!-- ══════════════════════════════════════════════════════════════════════
         ScrollBar chrome resources  (Light defaults; Dark values are set per-
         instance via this.Resources[key] in OpenDataGrid.ApplyTheme).
         ══════════════════════════════════════════════════════════════════════ -->

    <SolidColorBrush x:Key="ODG.ScrollBar.Track"      Color="#F0F0F0"/>
    <SolidColorBrush x:Key="ODG.ScrollBar.Thumb"      Color="#CDCDCD"/>
    <SolidColorBrush x:Key="ODG.ScrollBar.ThumbHover" Color="#A6A6A6"/>
    <SolidColorBrush x:Key="ODG.ScrollBar.ThumbDrag"  Color="#606060"/>

    <!-- Page-scroll button (invisible hit-target in the track) -->
    <Style x:Key="ODG.ScrollBar.PageButton" TargetType="{x:Type RepeatButton}">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Background"            Value="Transparent"/>
        <Setter Property="Focusable"             Value="False"/>
        <Setter Property="IsTabStop"             Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Border Background="{TemplateBinding Background}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Thumb (draggable part) -->
    <Style x:Key="ODG.ScrollBar.ThumbStyle" TargetType="{x:Type Thumb}">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="IsTabStop"             Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Border x:Name="ThumbBorder"
                            Background="{DynamicResource ODG.ScrollBar.Thumb}"
                            CornerRadius="3"
                            Margin="2,2"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbBorder" Property="Background"
                                    Value="{DynamicResource ODG.ScrollBar.ThumbHover}"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ThumbBorder" Property="Background"
                                    Value="{DynamicResource ODG.ScrollBar.ThumbDrag}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Vertical ScrollBar template -->
    <ControlTemplate x:Key="ODG.VerticalScrollBarTemplate" TargetType="{x:Type ScrollBar}">
        <Grid Background="{DynamicResource ODG.ScrollBar.Track}" SnapsToDevicePixels="True">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Style="{StaticResource ODG.ScrollBar.PageButton}"
                                  Command="ScrollBar.PageUpCommand"/>
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Style="{StaticResource ODG.ScrollBar.PageButton}"
                                  Command="ScrollBar.PageDownCommand"/>
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource ODG.ScrollBar.ThumbStyle}"/>
                </Track.Thumb>
            </Track>
        </Grid>
    </ControlTemplate>

    <!-- Horizontal ScrollBar template -->
    <ControlTemplate x:Key="ODG.HorizontalScrollBarTemplate" TargetType="{x:Type ScrollBar}">
        <Grid Background="{DynamicResource ODG.ScrollBar.Track}" SnapsToDevicePixels="True">
            <Track x:Name="PART_Track" IsDirectionReversed="False">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Style="{StaticResource ODG.ScrollBar.PageButton}"
                                  Command="ScrollBar.PageLeftCommand"/>
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Style="{StaticResource ODG.ScrollBar.PageButton}"
                                  Command="ScrollBar.PageRightCommand"/>
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource ODG.ScrollBar.ThumbStyle}"/>
                </Track.Thumb>
            </Track>
        </Grid>
    </ControlTemplate>

    <!-- Combined ScrollBar style (switches template based on orientation) -->
    <Style x:Key="ODG.ScrollBarStyle" TargetType="{x:Type ScrollBar}">
        <Setter Property="OverridesDefaultStyle"     Value="True"/>
        <Setter Property="Stylus.IsFlicksEnabled"    Value="False"/>
        <Setter Property="MinWidth"                  Value="0"/>
        <Setter Property="MinHeight"                 Value="0"/>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Vertical">
                <Setter Property="Width"    Value="10"/>
                <Setter Property="Template" Value="{StaticResource ODG.VerticalScrollBarTemplate}"/>
            </Trigger>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Height"   Value="10"/>
                <Setter Property="Template" Value="{StaticResource ODG.HorizontalScrollBarTemplate}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ══════════════════════════════════════════════════════════════════════
         OpenDataGrid main style
         ══════════════════════════════════════════════════════════════════════ -->

    <Style TargetType="{x:Type local:OpenDataGrid}">
        <Setter Property="Background"     Value="White"/>
        <Setter Property="BorderBrush"    Value="{Binding ChromeBorderBrush, RelativeSource={RelativeSource Self}}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Focusable"      Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:OpenDataGrid}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Header area -->
                            <Border Grid.Row="0" Grid.Column="0"
                                    Background="{TemplateBinding HeaderAreaBackground}"
                                    BorderBrush="{TemplateBinding ChromeBorderBrush}"
                                    BorderThickness="0,0,0,1"
                                    ClipToBounds="True">
                                <Canvas x:Name="PART_HeaderCanvas"
                                        Height="{TemplateBinding HeaderHeight}"
                                        ClipToBounds="True"/>
                            </Border>

                            <!-- Per-column filter row (collapsed when no column has FilteringEnabled) -->
                            <Border x:Name="PART_FilterRowContainer"
                                    Grid.Row="1" Grid.Column="0"
                                    Background="{TemplateBinding FilterRowBackground}"
                                    BorderBrush="{TemplateBinding ChromeBorderBrush}"
                                    BorderThickness="0,0,0,1"
                                    ClipToBounds="True"
                                    Visibility="Collapsed">
                                <Canvas x:Name="PART_FilterRowCanvas"
                                        Height="{TemplateBinding FilterRowHeight}"
                                        ClipToBounds="True"/>
                            </Border>

                            <!-- Data canvas -->
                            <Canvas x:Name="PART_Canvas"
                                    Grid.Row="2" Grid.Column="0"
                                    ClipToBounds="True"
                                    Background="Transparent"/>

                            <!-- Vertical ScrollBar -->
                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                       Style="{StaticResource ODG.ScrollBarStyle}"
                                       Grid.Row="0" Grid.RowSpan="3" Grid.Column="1"
                                       Orientation="Vertical"
                                       Minimum="0" Maximum="0" Value="0"/>

                            <!-- Horizontal ScrollBar -->
                            <ScrollBar x:Name="PART_HorizontalScrollBar"
                                       Style="{StaticResource ODG.ScrollBarStyle}"
                                       Grid.Row="3" Grid.Column="0"
                                       Orientation="Horizontal"
                                       Minimum="0" Maximum="0" Value="0"
                                       Visibility="Collapsed"/>

                            <!-- Subtle semi-transparent overlay (controlled by LoadingIndicatorMode) -->
                            <Border x:Name="PART_LoadingOverlay"
                                    Grid.Row="2" Grid.Column="0"
                                    Background="{TemplateBinding LoadingOverlayBackground}"
                                    Visibility="Collapsed"
                                    IsHitTestVisible="True"/>
                            <!-- Thin animated progress bar at the top (controlled by LoadingIndicatorMode) -->
                            <ProgressBar x:Name="PART_LoadingBar"
                                         Grid.Row="2" Grid.Column="0"
                                         Height="3"
                                         VerticalAlignment="Top"
                                         HorizontalAlignment="Stretch"
                                         IsIndeterminate="True"
                                         Visibility="Collapsed"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         IsHitTestVisible="False"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <Style TargetType="{x:Type local:OpenDataGridTextFilter}"
           BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Padding" Value="4,2"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style TargetType="{x:Type local:OpenDataGridComboFilter}"
           BasedOn="{StaticResource {x:Type ComboBox}}"/>

</ResourceDictionary>
